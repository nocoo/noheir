{
	"$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"css": {
		"parser": {
			"cssModules": true
		}
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/.next",
			"!**/.next-e2e",
			"!**/coverage",
			"!**/_archive",
			"!**/playwright-report",
			"!**/test-results",
			"!**/.wrangler",
			"!**/public",
			"!**/*.sql",
			"!**/*.sql.gz",
			"!**/*.d.ts",
			"!**/*.tsbuildinfo",
			"!**/bun.lock",
			"!**/CHANGELOG.md",
			"!**/autoresearch.jsonl"
		]
	}
}
