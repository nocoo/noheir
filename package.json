{
  "name": "noheir",
  "version": "3.1.2",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && bun run worker:typecheck",
    "test": "vitest run",
    "test:worker": "cd worker && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.ts && bun run test:environments",
    "test:e2e:bdd": "bunx playwright test",
    "worker:typecheck": "cd worker && tsc --noEmit",
    "prepare": "husky",
    "release": "bun run scripts/release.ts",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "bun scripts/deploy.ts",
    "deploy:check": "bun run build && wrangler deploy --dry-run",
    "verify:production": "bun scripts/verify-deployment.ts",
    "types": "wrangler types worker/worker-configuration.d.ts --env-interface WorkerBindings --include-runtime=false --strict-vars=false",
    "prod:login": "cloudflared access login https://noheir.hexly.ai",
    "demo:reset": "node scripts/reset-demo.ts",
    "test:environments": "node --test scripts/environments.test.ts",
    "test:environments:browser": "bun run build && node scripts/check-environments.ts",
    "demo:capture": "bun run build && node scripts/check-environments.ts --capture",
    "dev:built": "node scripts/dev.ts --built"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@nivo/sunburst": "0.99.0",
    "@nocoo/basalt": "3.2.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "esbuild": "^0.28.2",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "lucide-react": "1.59.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.5.0",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261019.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "husky": "^9.1.7",
    "jsdom": "30.1.3",
    "miniflare": "5.20261006.1-alpha",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.2"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "@tailwindcss/oxide",
    "workerd"
  ],
  "overrides": {
    "esbuild": "^0.28.2",
    "hono": "4.13.13",
    "postcss": "8.5.31",
    "sharp": "0.35.5",
    "undici": "8.10.2",
    "wrangler": "4.151.2",
    "zod": "4.6.7",
    "source-map-js": "1.2.2"
  },
  "type": "module",
  "packageManager": "bun@1.4.2"
}
