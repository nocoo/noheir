# 本地开发环境变量。复制为 .env.local 后填入真实值。
# 生产的真实值存放在 VPS `/opt/noheir/.env`（chmod 600），可从那里拷回。
# 详细部署架构见 docs/04-run.md。

# ── Cloudflare Worker (SQL API → D1) ─────────────────────────────
# Worker 部署在 noheir.worker.hexly.ai；本地开发也直连生产 Worker，
# 无需本地跑 wrangler dev（除非在改 worker 本身）。
WORKER_URL=https://noheir.worker.hexly.ai
WORKER_TOKEN=

# ── NextAuth ─────────────────────────────────────────────────────
# AUTH_SECRET: 生成新的用 `openssl rand -base64 32`。
# 本地开发用随机值即可；同步到生产会让所有已登录 session 失效。
AUTH_SECRET=
# NEXTAUTH_URL: 当前实例对外 URL。本地填 http://localhost:7004；
# 生产是 https://noheir.hexly.ai（走 Cloudflare + Caddy）。
NEXTAUTH_URL=http://localhost:7004

# ── Google OAuth ─────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials。
# 本地开发需在授权重定向 URI 里添加 http://localhost:7004/api/auth/callback/google。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 访问控制 ─────────────────────────────────────────────────────
# 登录白名单，逗号分隔。不在此列表的邮箱登录会被 middleware 拒绝。
ALLOWED_EMAILS=

# ── Dev 反代（可选）───────────────────────────────────────────────
# 当在本地用反向代理（如 Caddy）暴露到自定义域时才需要，逗号分隔的
# 允许 host 列表。默认只允许 localhost。
# ALLOWED_DEV_ORIGINS=noheir.dev.hexly.ai
